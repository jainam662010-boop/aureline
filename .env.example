# ============================================================================
# Aureline DTF Studio — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Database ----------------------------------------------------------------
# Ships configured for SQLite so the app runs with zero services:
#   DATABASE_URL="file:./dev.db"
# For production (Postgres), change provider = "postgresql" in prisma/schema.prisma
# and use a Supabase / Neon / Vercel Postgres connection string (pooler URL here,
# direct URL in DIRECT_URL for migrations).
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# --- App ---------------------------------------------------------------------
# Public base URL of the deployment (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Aureline Atelier"

# --- Auth --------------------------------------------------------------------
# Generate: openssl rand-base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# NextAuth v4 legacy name (kept for compatibility)
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Seed admin login --------------------------------------------------------
SEED_ADMIN_EMAIL="admin@aureline.in"
SEED_ADMIN_PASSWORD="Admin@12345"

# --- Razorpay (https://dashboard.razorpay.com) -------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: webhook secret configured on the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=""

# --- File storage: Cloudinary (recommended on Vercel) ------------------------
# Leave CLOUDINARY_URL empty to fall back to local /public/uploads (dev only —
# files are ephemeral on serverless hosts).
CLOUDINARY_URL=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Transactional email: Resend (optional - falls back to console logging) --
RESEND_API_KEY=""
EMAIL_FROM="Aureline Atelier <orders@aureline.in>"

# --- WhatsApp notify (optional - falls back to console log + wa.me link) -----
# Storefront captures a WhatsApp number at checkout. When an admin accepts a
# request (moves it out of PENDING_PAYMENT) we message the customer there.
# Leave empty in dev: the acceptance message is console-logged and an internal
# order note + one-click "WhatsApp request accepted" button (wa.me) are used.
# Create a Cloud API app at https://developers.facebook.com/apps/ (WhatsApp ->
# API Setup) and paste the token + phone number ID below.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# --- Site commerce configuration (defaults; admins can override in /admin) ---
# Default GST rate applied when a product has no explicit rate (%)
DEFAULT_GST_RATE="18"
# Flat shipping surcharge applied on top of zone rates (paise-free rupees)
DEFAULT_SHIPPING_FEE="79"
# Orders above this amount get free standard shipping (0 disables)
FREE_SHIPPING_THRESHOLD="1499"
